#!/bin/sh
# Optional local pre-push guard against pinned-rustfmt churn.
# Enable once per clone with: git config core.hooksPath .githooks
# This hook is advisory only; CI remains the verification gate per CONTRIBUTING.md.
# It never modifies files, only reports what CI would reject.
set -eu

if command -v cargo >/dev/null 2>&1; then
  if ! cargo fmt --all -- --check >/dev/null 2>&1; then
    echo "pre-commit: cargo fmt --all -- --check reports diffs."
    echo "Run: cargo fmt --all   (pinned toolchain 1.99.0 via rust-toolchain.toml)"
    exit 1
  fi
else
  echo "pre-commit: cargo not found; skipping rustfmt check (CI will verify)."
fi

if ! git diff --check; then
  echo "pre-commit: git diff --check reports whitespace errors."
  exit 1
fi

if command -v python >/dev/null 2>&1; then
  if ! python tools/check_docs.py >/dev/null 2>&1; then
    echo "pre-commit: tools/check_docs.py failed."
    exit 1
  fi
fi

exit 0
