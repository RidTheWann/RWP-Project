#!/bin/sh
# Optional local hygiene guard (no git usage).
# This hook is advisory only; the local gate per docs/local-gates.md is the
# verification authority. It never modifies files, only reports.
set -eu

if command -v cargo >/dev/null 2>&1; then
  if ! cargo fmt --all -- --check >/dev/null 2>&1; then
    echo "pre-commit: cargo fmt --all -- --check reports diffs."
    echo "Run: cargo fmt --all   (pinned toolchain 1.99.0 via rust-toolchain.toml)"
    exit 1
  fi
else
  echo "pre-commit: cargo not found; skipping rustfmt check."
fi

if command -v python >/dev/null 2>&1; then
  if ! python tools/check_docs.py >/dev/null 2>&1; then
    echo "pre-commit: tools/check_docs.py failed."
    exit 1
  fi
  if ! python tools/check_links.py >/dev/null 2>&1; then
    echo "pre-commit: tools/check_links.py failed."
    exit 1
  fi
fi

exit 0
